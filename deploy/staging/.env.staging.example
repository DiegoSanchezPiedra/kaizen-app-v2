# Staging (copiar a .env.staging en la raíz; está en .gitignore). Nada de producción, nada de la cuenta live de Stripe.
# Genera los secretos con:  openssl rand -base64 32     (VAPID: npx web-push generate-vapid-keys)

# ── BD de staging (docker-compose.staging.yaml) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
MIGRATOR_PASSWORD=change_me
APP_PASSWORD=change_me
SERVICE_PASSWORD=change_me
DATABASE_URL=postgresql://migrator:change_me@localhost:5433/kaizen_staging
DATABASE_URL_APP=postgresql://app_user:change_me@localhost:5433/kaizen_staging
DATABASE_URL_SERVICE=postgresql://service_role:change_me@localhost:5433/kaizen_staging

# ── API ──
NODE_ENV=production
PORT=3100
JWT_SECRET=
# Obligatoria al arrancar. Para el login con Google: un cliente OAuth con el dominio de ngrok como origen autorizado, y el
# mismo valor en frontend/.env.production (VITE_GOOGLE_CLIENT_ID) ANTES de compilar. Sin eso, déjala con un valor
# cualquiera: el botón de Google no sale y se entra con email y contraseña.
GOOGLE_CLIENT_ID=staging-sin-google
QR_HMAC_SECRET=
TOTP_ENCRYPTION_KEY=
MFA_ENCRYPTION_KEY=
MFA_TOKEN_EXPIRES_IN=5m
MFA_TOTP_ISSUER=Kaizen Staging
MFA_RECOVERY_CODE_COUNT=10
AGREEMENTS_STORAGE_PATH=./storage-staging/agreements

# URL pública (la de ngrok, https): los enlaces de los emails, de Stripe y de recuperar contraseña salen de aquí.
APP_URL=https://TU-DOMINIO.ngrok-free.app

# ── Stripe: SOLO PRUEBA (sk_test_ / rk_test_). El webhook se registra en el sandbox apuntando a APP_URL/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_STATEMENT_DESCRIPTOR="KAI ZEN TRAINING CAMP"

# ── Emails: Resend (log = solo fichero, el cliente no los vería) ──
EMAIL_TRANSPORT=resend
RESEND_API_KEY=
EMAIL_FROM=Kaizen <onboarding@resend.dev>
EMAIL_REPLY_TO=
EMAIL_LOG_PATH=./storage-staging/emails.log

# ── Push (necesita HTTPS: ngrok lo da) ──
PUSH_TRANSPORT=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com
PUSH_LOG_PATH=./storage-staging/push.log

# ── Datos de demo (npm run staging:seed) ──
SEED_PASSWORD=
SEED_EMAIL_DOMAIN=staging.test
