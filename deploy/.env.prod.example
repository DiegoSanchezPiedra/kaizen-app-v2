# Producción: copiar a .env en la raíz del VPS (está en .gitignore). Complementa a .env.example (mismas variables de la API).
# Secretos: openssl rand -hex 24 (sin @ : / # % en las contraseñas de BD; repítelas en las tres DATABASE_URL*).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
SERVICE_PASSWORD=
DB_NAME=kaizen
DATABASE_URL=postgresql://migrator:MIGRATOR_PASSWORD@db:5432/kaizen
DATABASE_URL_APP=postgresql://app_user:APP_PASSWORD@db:5432/kaizen
DATABASE_URL_SERVICE=postgresql://service_role:SERVICE_PASSWORD@db:5432/kaizen
TRUST_PROXY=1
APP_URL=https://TU-DOMINIO
# Se compilan en el frontend (GOOGLE_CLIENT_ID también la lee la API)
GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
# Email (Brevo): el remitente debe ser de un dominio autenticado en Brevo (SPF, DKIM, DMARC); mejor un subdominio (mail.TU-DOMINIO).
EMAIL_TRANSPORT=brevo
BREVO_API_KEY=
# Secreto del webhook de rebotes de Brevo (ADR 0029): openssl rand -hex 32. Se registra en Brevo como cabecera x-brevo-secret.
BREVO_WEBHOOK_SECRET=
EMAIL_FROM=Kaizen <no-reply@mail.TU-DOMINIO>
EMAIL_REPLY_TO=
# Dominio del correo corporativo de los profesores (ADR 0028; obligatorio en producción)
CORPORATE_EMAIL_DOMAIN=TU-DOMINIO
# Push (Web Push, sin Firebase): npx web-push generate-vapid-keys. Rotar = cambiar las dos y vaciar push_subscriptions.
PUSH_TRANSPORT=webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:CORREO-DE-LA-ACADEMIA
# Resto de variables de la API (JWT_SECRET, STRIPE_*, MFA_*): ver .env.example. Stripe, en claves de test hasta B10.7.
# No definas AGREEMENTS_STORAGE_PATH ni los *_LOG_PATH: el compose fija el storage en el volumen.
