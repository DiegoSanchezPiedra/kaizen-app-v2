# Producción: copiar a .env en la raíz del VPS (está en .gitignore). Complementa a .env.example (mismas variables de la API).
# Secretos: openssl rand -hex 24 (sin @ : / # % en las contraseñas de BD; repítelas en las tres DATABASE_URL*).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MIGRATOR_PASSWORD=
APP_PASSWORD=
SERVICE_PASSWORD=
DB_NAME=kaizen
DATABASE_URL=postgresql://migrator:MIGRATOR_PASSWORD@db:5432/kaizen
DATABASE_URL_APP=postgresql://app_user:APP_PASSWORD@db:5432/kaizen
DATABASE_URL_SERVICE=postgresql://service_role:SERVICE_PASSWORD@db:5432/kaizen
TRUST_PROXY=1
APP_URL=https://TU-DOMINIO
# Se compilan en el frontend (GOOGLE_CLIENT_ID también la lee la API)
GOOGLE_CLIENT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=
# Resto de variables de la API (JWT_SECRET, STRIPE_*, MFA_*, EMAIL_*, PUSH_*): ver .env.example
# No definas AGREEMENTS_STORAGE_PATH ni los *_LOG_PATH: el compose fija el storage en el volumen.
