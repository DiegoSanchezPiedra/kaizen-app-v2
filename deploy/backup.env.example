# Copiar a /etc/kaizen/backup.env en el VPS (chmod 600, solo root). Lo lee deploy/backup.sh. Sin BORG_REPO no hay copia fuera del VPS.
# Repositorio de BorgBase (región UE) con clave SSH solo de añadir (append-only) y repositorio cifrado (repokey-blake2).
BORG_REPO=ssh://USUARIO@USUARIO.repo.borgbase.com/./repo
# La passphrase y la clave del repositorio (borg key export) se guardan TAMBIÉN fuera del VPS (gestor de contraseñas):
# sin ellas, la copia no se puede abrir.
BORG_PASSPHRASE=
BORG_RSH='ssh -i /root/.ssh/borgbase -o StrictHostKeyChecking=accept-new'
# URL de ping de healthchecks.io: avisa si el backup deja de ejecutarse (vacío = sin aviso).
HC_URL=
