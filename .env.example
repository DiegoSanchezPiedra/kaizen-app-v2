
# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=kaizen_app

# Backend
DATABASE_URL=postgresql://kaizen_app_user:change_me_app@db:5432/kaizen_app

# JWT
JWT_SECRET=change_me_with_a_long_random_secret

# Stripe
STRIPE_SECRET_KEY=rk_test_your_restricted_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# TOTP
TOTP_ENCRYPTION_KEY=change_me_with_a_32_byte_key

# QR
QR_HMAC_SECRET=change_me_with_a_long_random_secret

# B4 (MFA admin):
MFA_ENCRYPTION_KEY=<32 bytes base64 o hex>
MFA_TOKEN_EXPIRES_IN=5m
MFA_TOTP_ISSUER=Kaizen App
MFA_RECOVERY_CODE_COUNT=10
# B4.5.1:
AGREEMENTS_STORAGE_PATH=./storage/agreements
