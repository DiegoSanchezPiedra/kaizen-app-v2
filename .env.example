
# PostgreSQL (Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_admin
POSTGRES_DB=kaizen_app

# Backend
DATABASE_URL=postgresql://kaizen_app_user:change_me_app@db:5432/kaizen_app

# Saltos de proxy delante de la API para req.ip (rate limiting): 1 = Nginx en el VPS; 2 = Tailscale Funnel + Nginx (staging)
# TRUST_PROXY=1

# Login con Google (obligatoria al arrancar; el mismo valor que VITE_GOOGLE_CLIENT_ID del frontend)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# JWT
JWT_SECRET=change_me_with_a_long_random_secret
# JWT_EXPIRES_IN=7d
# ADMIN_JWT_EXPIRES_IN=12h

# Stripe
STRIPE_SECRET_KEY=rk_test_your_restricted_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PORTAL_CONFIGURATION_ID=bpc_from_npm_run_stripe-portal-config
# Descriptor del extracto en los Products de Kaizen (5–22 caracteres latinos); vacío = el de la cuenta
STRIPE_STATEMENT_DESCRIPTOR="KAI ZEN TRAINING CAMP"
APP_URL=http://localhost:5173

# B4 (MFA admin):
MFA_ENCRYPTION_KEY=<32 bytes base64 o hex>
MFA_TOKEN_EXPIRES_IN=5m
MFA_TOTP_ISSUER=Kaizen App
MFA_RECOVERY_CODE_COUNT=10
# B4.5.1:
AGREEMENTS_STORAGE_PATH=./storage/agreements
# B10.6 (avisos por email): log (consola + EMAIL_LOG_PATH) o resend
EMAIL_TRANSPORT=log
RESEND_API_KEY=re_your_key_here
EMAIL_FROM=Kaizen <onboarding@resend.dev>
EMAIL_REPLY_TO=academia@example.com
EMAIL_LOG_PATH=./storage/emails.log
# B15 (push): log (consola + PUSH_LOG_PATH) o webpush. Claves: npx web-push generate-vapid-keys
PUSH_TRANSPORT=log
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:academia@example.com
PUSH_LOG_PATH=./storage/push.log
