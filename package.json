    "test:bookings": "dotenv -e .env -- node scripts/test-bookings.js",
    "test:attendance": "dotenv -e .env -- node scripts/test-attendance.js",
    "extend-horizon": "dotenv -e .env -- node scripts/extend-horizon.js",
    "lint": "eslint \"src/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [],
